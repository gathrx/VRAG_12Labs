# Copy this file to .env and fill in your values. Never commit .env.

# Required: https://playground.twelvelabs.io/dashboard/api-keys
TWELVELABS_API_KEY=

# Optional: reuse an existing knowledge store (ks_...). Leave empty and the app
# creates one on the first upload and remembers it in data/metadata.json.
TWELVELABS_KNOWLEDGE_STORE_ID=
TWELVELABS_KNOWLEDGE_STORE_NAME=vrag-streamlit

# Optional tuning
# Seconds to wait for a single API request (Jockey answers can take a few minutes).
TWELVELABS_REQUEST_TIMEOUT=600
# Seconds to wait for upload processing / indexing before asking you to resume.
TWELVELABS_INDEX_TIMEOUT=7200
# Where videos, frames, metadata and logs are stored.
VRAG_DATA_DIR=data
